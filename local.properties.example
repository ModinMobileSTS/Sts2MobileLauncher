# STS2 Android local build options.
#
# Copy this file to `local.properties` and edit non-secret local options. The file is ignored
# by git. Environment variables still take precedence where a script supports both.

# Gradle task used by package scripts.
android.gradle.task=assembleMonoRelease

# APK output copied by package scripts after Gradle finishes.
android.apk.output=android/build/outputs/apk/mono/release/sts2-re.apk
# Stable distribution copies produced by package scripts.
android.importer.dist=dist/sts2-re-importer.apk
android.direct.dist=dist/sts2-re-direct.apk

# Android signing defaults used by package scripts for local release builds. Prefer the
# environment variables RELEASE_KEYSTORE_FILE / RELEASE_KEYSTORE_PASSWORD /
# RELEASE_KEYSTORE_ALIAS for secrets or CI.
# Published APK updates must keep the original private key AND certificate;
# another debug.keystore with the same alias/password is a different identity.
android.release_keystore_file=${HOME}/.android/debug.keystore
android.release_keystore_password=android
android.release_keystore_alias=androiddebugkey

# Experimental, SHA-pinned Mono total-memory query repair (0=original, 1=fixed).
# Does not rebuild Mono or change available-memory queries/heap limits.
# Environment override: MONO_MEMORY_STATS_FIX=1. Keep the reference libs original.
runtime.mono_memory_stats_fix=0
# Optional directory containing the matching FMOD 2.03.06 Android arm64 engine + Godot bridge.
# Defaults to arm64/ beside STS2_FMOD_PLUGIN_AAR; env override: STS2_FMOD_ANDROID_LIBS_DIR.
# runtime.fmod_android_libs_dir=/path/to/fmod/android/arm64

# Default fallback uses the current v0.114.0 public-beta reference. Older flavors
# remain selectable, including original-v0.113.0 with the v0.113.1 reference.
compat.default_reference_flavor=original-v0.114.0
# "release" verifies and embeds the pinned official ZIP. Use "matrix" to test
# local port-mod changes, or "legacy" for schema-1 branch diagnostics.
compat.pack_build_mode=release
# Optional tag override; leave unset to use tools/android/bundled-compat-release.json.
# compat.bundled_release_tag=v0.8.0
# Optional offline directory with the signed index, signature, and original ZIP.
# compat.bundled_release_dir=/path/to/release-assets
compat.bundled_packs_config=tools/android/bundled-compat-packs.json
compat.asset_dir=android/assets/compat_packs
compat.worktree_root=.agent/worktrees/compat-packs
compat.pack_remote=origin
compat.apply_build_info_patches=1

# Optional path (not PEM contents) for compatibility GitHub Releases.
# Keep the private key outside both Git checkouts.
# Overrides: COMPAT_RELEASE_SIGNING_KEY_FILE / COMPAT_RELEASE_SIGNING_KEY_ID.
# compat.release_signing_key_file=${HOME}/.config/sts2-re/compat-release-ed25519.pem
# compat.release_signing_key_id=sts2-compat-release-v1

# External GitHub reference project preparation.
deps.external_projects_config=tools/deps/external-github-projects.json
deps.external_projects_root=.agent/reference-repos

# If `tools/package/build_direct_apk.sh` is called without an argument, it will use
# STS2_PAYLOAD_ZIP from .env. This option is documented here as a reminder that payloads
# are local/private inputs, not repository state.
