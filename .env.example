# STS2 Android rebuild environment.
#
# Copy this file to `.env` and edit paths for your machine. `.env` is ignored by git.
# Values may be absolute or relative to this repository root. Quote values that contain spaces.

# Optional umbrella path to an old/reference Android port. If set, unset tool/resource
# variables below can default to paths under this directory.
# STS2_REFERENCE_ROOT=/path/to/reference-android-port

# Required build tools.
# JAVA_HOME must point to a full JDK with `bin/javac` (Java 17+; this project often uses JDK 21).
JAVA_HOME=/path/to/jdk
ANDROID_HOME=/path/to/android-sdk
# ANDROID_SDK_ROOT defaults to ANDROID_HOME when omitted.
# ANDROID_SDK_ROOT=/path/to/android-sdk
DOTNET_BIN=/path/to/dotnet

# Reference launcher/runtime artifacts copied by tools/android/sync-runtime-from-references.sh.
# If STS2_REFERENCE_ROOT is set, these may be omitted when your reference layout matches it.
STS2_LAUNCHER_REFERENCE_ROOT=/path/to/reference-launcher-runtime
# STS2_ANDROID_RUNTIME_REFERENCE_ROOT points at a Godot Android template directory containing
# libs/, assets/dotnet_bcl/, and gradle/wrapper/gradle-wrapper.jar.
# STS2_ANDROID_RUNTIME_REFERENCE_ROOT=/path/to/reference-launcher-runtime/android
# STS2_RUNTIME_REFERENCE_DIR points at a Mono publish directory containing sts2.dll,
# GodotSharp.dll and 0Harmony.dll for ReferenceFlavor=runtime.
# STS2_RUNTIME_REFERENCE_DIR=/path/to/reference-launcher-runtime/upstream/godot-export/.godot/mono/publish/arm64
# STS2_CRYPTO_NATIVE_JAR defaults to $STS2_LAUNCHER_REFERENCE_ROOT/vendor/godot/modules/mono/thirdparty/libSystem.Security.Cryptography.Native.Android.jar.
# STS2_CRYPTO_NATIVE_JAR=/path/to/libSystem.Security.Cryptography.Native.Android.jar
STS2_FMOD_PLUGIN_AAR=/path/to/fmod-release.aar

# Original PC/Godot build references used by compatibility compile gates.
# You may set either *_ROOT (the extracted project root) or *_REFERENCE_DIR (the directory
# containing sts2.dll, GodotSharp.dll, and 0Harmony.dll). *_REFERENCE_DIR takes precedence.
STS2_ORIGINAL_V103_ROOT=/path/to/sts2-original-v0.103.2
# STS2_ORIGINAL_V103_REFERENCE_DIR=/path/to/sts2-original-v0.103.2/.godot/mono/temp/bin/Debug
STS2_ORIGINAL_V1061_ROOT=/path/to/sts2-original-v0.106.1
# STS2_ORIGINAL_V1061_REFERENCE_DIR=/path/to/sts2-original-v0.106.1/.godot/mono/temp/bin/Debug
STS2_ORIGINAL_V1070_ROOT=/path/to/sts2-original-v0.107.0
# STS2_ORIGINAL_V1070_REFERENCE_DIR=/path/to/sts2-original-v0.107.0/.godot/mono/temp/bin/Debug
STS2_ORIGINAL_V1071_ROOT=/path/to/sts2-original-v0.107.1
# STS2_ORIGINAL_V1071_REFERENCE_DIR=/path/to/sts2-original-v0.107.1/.godot/mono/temp/bin/Debug
STS2_ORIGINAL_V1080_ROOT=/path/to/sts2-original-v0.108.0
# STS2_ORIGINAL_V1080_REFERENCE_DIR=/path/to/sts2-original-v0.108.0/.godot/mono/temp/bin/Debug

# Local APK signing variables used by tools/package/*.sh. Defaults below use the
# standard Android debug keystore for reproducible local sideload builds; replace
# them with release signing secrets only in your private .env or CI secret store.
RELEASE_KEYSTORE_FILE=${HOME}/.android/debug.keystore
RELEASE_KEYSTORE_PASSWORD=android
RELEASE_KEYSTORE_ALIAS=androiddebugkey

# Optional convenience input used when build_direct_apk.sh is called without an argument.
# Do not point this at a file you intend to commit; game payload zips must remain local/private.
# STS2_PAYLOAD_ZIP=/path/to/SlayTheSpire2.zip

# Optional root used by tools/deps/prepare-external-projects.sh for GitHub reference clones.
# STS2_EXTERNAL_PROJECTS_ROOT=.agent/reference-repos

# Optional inputs for historical diff inventory tooling.
# STS2_DIFF_MOBILE_ROOT=/path/to/old-mobile-port
# STS2_DIFF_ORIGINAL_ROOT=/path/to/original-pc-source
