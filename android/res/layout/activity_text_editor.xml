<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sts2_crash_background"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Sts2Crash.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_editor_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/sts2_crash_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_editor_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/sts2_crash_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Sts2Crash.Card"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <EditText
            android:id="@+id/input_editor_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:fontFamily="monospace"
            android:gravity="start|top"
            android:imeOptions="flagNoEnterAction"
            android:inputType="textMultiLine|textNoSuggestions"
            android:lineSpacingExtra="2dp"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:textColor="@color/sts2_crash_on_surface"
            android:textColorHint="@color/sts2_crash_on_surface_variant"
            android:textSize="13sp" />
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
