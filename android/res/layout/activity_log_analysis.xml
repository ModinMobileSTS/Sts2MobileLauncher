<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/analysis_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:focusableInTouchMode="true"
    android:background="@color/sts2_crash_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/analysis_toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        app:title="@string/log_analysis_title" />

    <LinearLayout android:id="@+id/analysis_column" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/analysis_messages"
                android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"
                android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:clipToPadding="false" />
            <ScrollView android:id="@+id/analysis_welcome" android:layout_width="match_parent" android:layout_height="match_parent"
                android:fillViewport="true" android:clipToPadding="false">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:gravity="center" android:paddingHorizontal="24dp" android:paddingVertical="20dp">
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="64dp" android:layout_height="64dp" android:importantForAccessibility="no"
                        app:cardCornerRadius="22dp" app:cardBackgroundColor="?attr/colorPrimaryContainer" app:cardElevation="0dp" app:strokeWidth="0dp">
                        <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center"
                            android:src="@drawable/ic_ms_auto_awesome_24" app:tint="?attr/colorOnPrimaryContainer" android:contentDescription="@null" />
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp"
                        android:text="@string/log_analysis_welcome_title" android:gravity="center"
                        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall" android:textColor="?attr/colorOnSurface" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="360dp"
                        android:layout_marginTop="8dp" android:gravity="center" android:lineSpacingExtra="2dp"
                        android:text="@string/log_analysis_welcome" android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/analysis_prompt_crash"
                        style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="20dp" android:minHeight="48dp" android:text="@string/log_analysis_prompt_crash"
                        app:icon="@drawable/ic_ms_bug_report_24" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/analysis_prompt_mods"
                        style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:text="@string/log_analysis_prompt_mods"
                        app:icon="@drawable/ic_ms_search_24" app:iconGravity="textStart" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/analysis_connect"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:minHeight="48dp" android:visibility="gone" android:text="@string/log_analysis_config"
                        app:icon="@drawable/ic_ms_tune_24" app:iconGravity="textStart" />
                </LinearLayout>
            </ScrollView>
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp" android:layout_marginVertical="8dp" app:cardCornerRadius="26dp"
            app:cardBackgroundColor="@color/sts2_crash_surface_container" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="?attr/colorOutline">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingStart="18dp" android:paddingEnd="6dp" android:paddingVertical="4dp">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/analysis_question"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp"
                    android:paddingHorizontal="0dp" android:paddingVertical="8dp" android:background="@null" android:saveEnabled="false"
                    android:hint="@string/log_analysis_question" android:textColor="?attr/colorOnSurface" android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="17sp" android:inputType="textCapSentences|textMultiLine" android:maxLines="5" android:imeOptions="actionSend" />
                <com.google.android.material.button.MaterialButton android:id="@+id/analysis_send"
                    style="@style/Widget.Material3.Button.IconButton.Filled" android:layout_width="48dp" android:layout_height="48dp"
                    android:contentDescription="@string/log_analysis_send" app:icon="@drawable/ic_ms_arrow_forward_24" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
