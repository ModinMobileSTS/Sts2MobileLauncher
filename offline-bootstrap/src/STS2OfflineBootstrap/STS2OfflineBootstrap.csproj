<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>STS2Mobile</AssemblyName>
    <RootNamespace>STS2Mobile</RootNamespace>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OfflineBootstrapVersion Condition="'$(OfflineBootstrapVersion)' == ''">0.2.0-dev</OfflineBootstrapVersion>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OfflineBootstrapVersion</_Parameter1>
      <_Parameter2>$(OfflineBootstrapVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(RuntimeReferenceDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(RuntimeReferenceDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
